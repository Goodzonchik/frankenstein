{
  "name": "frankenstein",
  "version": "1.0.0",
  "description": "Frankenstein microservices monorepo",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "minio": "^8.0.1",
    "neo4j-driver": "^5.23.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "workspaces": [
    "frontend",
    "file-storage-service",
    "graph-db-service",
    "postgres-db-service"
  ],
  "scripts": {
    "install:all": "npm install",
    "build:all": "npm run build --workspaces",
    "start:all": "npm run start --workspaces",
    "test:all": "npm run test --workspaces",
    "lint:all": "npm run lint --workspaces",
    "clean:all": "npm run clean --workspaces || true",
    "frontend": "npm run start --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend",
    "frontend:test": "npm run test --workspace=frontend",
    "file-storage": "npm run start:dev --workspace=file-storage-service",
    "file-storage:build": "npm run build --workspace=file-storage-service",
    "file-storage:test": "npm run test --workspace=file-storage-service",
    "graph-db": "npm run start:dev --workspace=graph-db-service",
    "graph-db:build": "npm run build --workspace=graph-db-service",
    "graph-db:test": "npm run test --workspace=graph-db-service",
    "postgres-db": "npm run start:dev --workspace=postgres-db-service",
    "postgres-db:build": "npm run build --workspace=postgres-db-service",
    "postgres-db:test": "npm run test --workspace=postgres-db-service",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:restart": "docker-compose restart"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.1",
    "@angular/cli": "^18.0.1",
    "@angular/compiler-cli": "^18.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jasmine-core": "~5.1.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.4.1",
    "prettier": "^3.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.4.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
